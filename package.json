    "build:pages": "cross-env GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/AkaneRei-Offline NEXT_PUBLIC_SITE_URL=https://apxs114514.github.io/AkaneRei-Offline/ next build",
    "deploy": "node scripts/deploy.mjs",
